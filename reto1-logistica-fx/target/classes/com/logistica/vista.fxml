<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.logistica.Controller"
      spacing="16.0"
      prefWidth="560.0"
      prefHeight="600.0"
      styleClass="root-container">

    <padding>
        <Insets top="24.0" right="24.0" bottom="20.0" left="24.0" />
    </padding>

    <!-- Cabecera -->
    <VBox spacing="4.0" styleClass="header-box">
        <Label text="Gestión de Envíos Logísticos" styleClass="title-label" />
        <Label text="Registra nuevas expediciones y controla su estado en tiempo real." styleClass="subtitle-label" />
    </VBox>

    <Separator />

    <!-- Formulario de registro -->
    <GridPane hgap="12.0" vgap="12.0" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints minWidth="140.0" prefWidth="150.0" hgrow="NEVER" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="NEVER" />
            <RowConstraints vgrow="NEVER" />
            <RowConstraints vgrow="NEVER" />
        </rowConstraints>

        <Label text="Referencia de envío:"
               styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtReferencia"
                   promptText="Ej. ENV-2026-001"
                   GridPane.columnIndex="1" GridPane.rowIndex="0">
            <tooltip>
                <Tooltip text="Introduce un código identificador único para el envío (Alt+R)" />
            </tooltip>
        </TextField>

        <Label text="Estado del envío:"
               styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <!-- Modificación manual FXML: tooltip añadido al ComboBox -->
        <ComboBox fx:id="cmbEstado"
                  promptText="Selecciona un estado..."
                  maxWidth="Infinity"
                  GridPane.columnIndex="1" GridPane.rowIndex="1">
            <tooltip>
                <Tooltip text="Pulsa Espacio o Alt+E para desplegar los estados" />
            </tooltip>
        </ComboBox>

        <!-- Texto reactivo al cambio de control -->
        <Label fx:id="lblAyudaEstado"
               text="Selecciona un estado para ver su descripción operativa."
               wrapText="true"
               styleClass="helper-label"
               GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <!-- Botonera de acciones -->
    <HBox spacing="12.0" alignment="CENTER_RIGHT" styleClass="button-bar">
        <Button fx:id="btnLimpiar"
                text="Limpiar"
                onAction="#handleLimpiar"
                cancelButton="true"
                styleClass="btn-secondary" />
        <Button fx:id="btnGuardar"
                text="Guardar envío"
                onAction="#handleGuardar"
                defaultButton="true"
                styleClass="btn-primary" />
    </HBox>

    <!-- Mensaje de confirmación o error -->
    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"
           maxWidth="Infinity"
           visible="false"
           managed="false"
           styleClass="feedback-label" />

    <Separator />

    <!-- Listado visible de envíos -->
    <VBox spacing="8.0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT">
            <Label text="Envíos registrados" styleClass="section-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblContador" text="0 envíos" styleClass="counter-label" />
        </HBox>

        <ListView fx:id="lstEnvios" VBox.vgrow="ALWAYS" styleClass="shipments-list">
            <placeholder>
                <Label text="Todavía no hay envíos registrados." styleClass="placeholder-label" />
            </placeholder>
        </ListView>
    </VBox>

    <!-- Modificación manual FXML: barra informativa de atajos sin tocar el controlador -->
    <Label text="Atajos: Tab navegar · Espacio desplegar estado · Enter guardar · Esc limpiar · Alt+R/E/G/L"
           wrapText="true"
           styleClass="helper-label" />

</VBox>